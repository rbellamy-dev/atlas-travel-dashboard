{
  "$description": "Single source of truth for Atlas design tokens. Edit this file, then run `npm run tokens` to regenerate src/primitives.css, src/semantics.css and src/tokens.ts. Rationale for each value lives in design.md.",

  "palette": {
    "$description": "PRIMITIVES — raw values, named by what they are (hue-step). Theme-independent. Components never use these directly; semantic colors below point at them. Accents from coolors.co/114b5f-028090-e4fde1-456990-f45b69 (other teal/blue/coral steps are OKLab mixes of those); text is neutral gray, so colour only appears where it means something.",
    "white": "#ffffff",
    "slate25": "#f5f7f8",
    "slate50": "#eef1f3",
    "slate200": "#d8e0e4",
    "gray25": "#f8f9fa",
    "gray200": "#c9ced1",
    "gray400": "#9aa1a6",
    "gray600": "#555c61",
    "gray700": "#3a3f42",
    "gray950": "#0f1214",
    "black": { "value": "#08090a", "note": "never pure black" },
    "teal300": { "value": "#3ddfd4", "note": "teal brightened to glow on teal-950; the dark-mode accent" },
    "teal600": { "value": "#028090", "note": "source palette" },
    "teal650": { "value": "#0c6a7c", "note": "teal-600 deepened so primary badge text clears WCAG AA (4.5:1) on its tint, even over card-raised" },
    "teal700": { "value": "#114b5f", "note": "source palette" },
    "teal800": "#2c5e6e",
    "teal850": "#072d3a",
    "teal900": "#041f29",
    "teal950": "#011017",
    "blue300": { "value": "#8cbaf7", "note": "blue-500 brightened to read on teal-950" },
    "blue500": { "value": "#456990", "note": "source palette" },
    "coral400": { "value": "#f45b69", "note": "source palette; the only warm hue, so a delay is the first thing you see" },
    "coral700": { "value": "#a33a44", "note": "coral-400 deepened for text on white" }
  },

  "colors": {
    "$description": "SEMANTIC — named by job, one value per theme. Each is `{palette-key}`, or `{ \"value\": \"{palette-key}\", \"alpha\": n }` for a translucent tint. Raw hex is rejected here; add it to palette first. warning = delayed trips, info = upcoming trips.",
    "dark": {
      "background": "{teal950}",
      "foreground": "{gray25}",
      "foregroundStrong": "{white}",
      "foregroundBody": "{gray200}",
      "foregroundMuted": { "value": "{gray400}", "note": "5.6:1 on card-raised, 6.5:1 on card" },
      "card": "{teal900}",
      "cardRaised": "{teal850}",
      "border": "{teal800}",
      "input": "{teal800}",
      "primary": "{teal300}",
      "primaryForeground": "{teal950}",
      "primaryTint": { "value": "{teal300}", "alpha": 0.12 },
      "warning": "{coral400}",
      "warningTint": { "value": "{coral400}", "alpha": 0.1, "note": "10% keeps coral badge text at WCAG AA (4.7:1) on card; 14% would fail" },
      "info": "{blue300}",
      "infoTint": { "value": "{blue300}", "alpha": 0.12 },
      "destructive": "{coral400}",
      "ring": "{teal300}"
    },
    "light": {
      "background": "{slate25}",
      "foreground": "{gray950}",
      "foregroundStrong": "{black}",
      "foregroundBody": "{gray700}",
      "foregroundMuted": { "value": "{gray600}", "note": "6.0:1 on card-raised, 6.8:1 on card" },
      "card": "{white}",
      "cardRaised": "{slate50}",
      "border": "{slate200}",
      "input": "{slate200}",
      "primary": "{teal650}",
      "primaryForeground": "{white}",
      "primaryTint": { "value": "{teal650}", "alpha": 0.1, "note": "badge text stays at WCAG AA: 5.4:1 on card, 4.8:1 over card-raised" },
      "warning": "{coral700}",
      "warningTint": { "value": "{coral400}", "alpha": 0.1 },
      "info": "{blue500}",
      "infoTint": { "value": "{blue500}", "alpha": 0.1 },
      "destructive": "{coral700}",
      "ring": "{teal600}"
    }
  },

  "colorAliases": {
    "$description": "Extra Tailwind color utilities mapped onto existing semantic colors (shadcn expects these names) — not a second palette.",
    "cardForeground": "foreground",
    "destructiveForeground": "background",
    "muted": "cardRaised",
    "mutedForeground": "foregroundMuted",
    "secondary": "cardRaised",
    "secondaryForeground": "foreground",
    "accent": "cardRaised",
    "accentForeground": "foreground",
    "popover": "card",
    "popoverForeground": "foreground"
  },

  "fonts": {
    "display": "'Space Grotesk', sans-serif",
    "body": "'Inter', sans-serif",
    "mono": "'JetBrains Mono', monospace"
  },

  "radius": {
    "card": "0.875rem",
    "btn": "0.625rem",
    "icon": "0.75rem",
    "chip": "0.375rem",
    "pill": "9999px"
  },

  "shadows": {
    "glow": "0 2px 8px {teal300 @ 12%}",
    "glowHover": "0 4px 14px {teal300 @ 20%}"
  },

  "spacing": {
    "$description": "Documentation only — must stay on Tailwind's default 4px step (sp4 = p-4), so no --spacing-* utilities are emitted.",
    "sp1": 4,
    "sp2": 8,
    "sp3": 12,
    "sp4": 16,
    "sp5": 24,
    "sp6": 32,
    "sp7": 48,
    "sp8": 64
  },

  "typeScale": {
    "displayXl": { "size": "44px", "weight": 600, "lh": "1.05", "ls": "-0.02em", "font": "display" },
    "displayLg": { "size": "30px", "weight": 600, "lh": "1.1", "ls": "-0.02em", "font": "display" },
    "heading": { "size": "20px", "weight": 600, "lh": "1.2", "ls": "-0.01em", "font": "display" },
    "body": { "size": "15px", "weight": 400, "lh": "1.5", "ls": "0", "font": "body" },
    "bodySm": { "size": "13px", "weight": 400, "lh": "1.45", "ls": "0", "font": "body" },
    "label": { "size": "11px", "weight": 500, "lh": "1.3", "ls": "0.06em", "font": "mono" },
    "numeral": { "size": "15px", "weight": 500, "lh": "1.3", "ls": "0", "font": "mono" }
  },

  "motion": {
    "easeOutExpo": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durFast": "150ms",
    "durBase": "260ms",
    "durSlow": "480ms",
    "durStagger": "60ms"
  }
}
