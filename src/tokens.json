{
  "$description": "Single source of truth for Atlas design tokens. Edit this file, then run `npm run tokens` to regenerate src/primitives.css, src/semantics.css and src/tokens.ts. Rationale for each value lives in design.md.",

  "palette": {
    "$description": "PRIMITIVES — raw values, named by what they are (hue-step). Theme-independent. Components never use these directly; semantic colors below point at them.",
    "white": "#ffffff",
    "ink25": "#f8fbfd",
    "ink50": "#f4f7fa",
    "ink75": "#eef4f9",
    "ink100": "#eef2f6",
    "ink200": "#d7dee6",
    "ink300": "#b8c4cf",
    "ink500": "#828e9a",
    "ink600": "#5f6a78",
    "ink700": "#414c59",
    "ink800": "#263140",
    "ink850": "#1a2129",
    "ink900": "#12181f",
    "ink925": "#0d1420",
    "ink950": "#0a0e14",
    "ink975": "#060a10",
    "cyan300": "#67e8f9",
    "cyan400": "#22d3ee",
    "cyan600": "#0891b2",
    "cyan700": "#0e7490",
    "amber400": "#fbbf24",
    "amber700": "#b45309",
    "amber750": { "value": "#a94d08", "note": "off-scale: amber-700 darkened to clear WCAG AA (4.5:1) as badge text on amber-tint" },
    "violet400": "#a78bfa",
    "violet600": "#7c3aed",
    "red400": "#f87171",
    "red600": "#dc2626"
  },

  "colors": {
    "$description": "SEMANTIC — named by job, one value per theme. Each is `{palette-key}`, or `{ \"value\": \"{palette-key}\", \"alpha\": n }` for a translucent tint. Raw hex is rejected here; add it to palette first.",
    "dark": {
      "background": "{ink950}",
      "foreground": "{ink75}",
      "foregroundStrong": "{ink25}",
      "foregroundBody": "{ink300}",
      "foregroundMuted": { "value": "{ink500}", "note": "clears WCAG AA (4.5:1) on card AND card-raised" },
      "card": "{ink900}",
      "cardRaised": "{ink850}",
      "border": "{ink800}",
      "input": "{ink800}",
      "primary": "{cyan400}",
      "primaryForeground": "{ink950}",
      "primaryTint": { "value": "{cyan400}", "alpha": 0.1 },
      "amber": "{amber400}",
      "amberTint": { "value": "{amber400}", "alpha": 0.1 },
      "violet": "{violet400}",
      "violetTint": { "value": "{violet400}", "alpha": 0.1 },
      "destructive": "{red400}",
      "ring": "{cyan300}"
    },
    "light": {
      "background": "{ink50}",
      "foreground": "{ink925}",
      "foregroundStrong": "{ink975}",
      "foregroundBody": "{ink700}",
      "foregroundMuted": "{ink600}",
      "card": "{white}",
      "cardRaised": "{ink100}",
      "border": "{ink200}",
      "input": "{ink200}",
      "primary": "{cyan700}",
      "primaryForeground": "{white}",
      "primaryTint": { "value": "{cyan700}", "alpha": 0.12, "note": "12% is the strongest that keeps text-primary badge text at WCAG AA (4.5:1) on card — cyan is the limit at 4.53:1" },
      "amber": "{amber750}",
      "amberTint": { "value": "{amber700}", "alpha": 0.12 },
      "violet": "{violet600}",
      "violetTint": { "value": "{violet600}", "alpha": 0.12 },
      "destructive": "{red600}",
      "ring": "{cyan600}"
    }
  },

  "colorAliases": {
    "$description": "Extra Tailwind color utilities mapped onto existing semantic colors (shadcn expects these names) — not a second palette.",
    "cardForeground": "foreground",
    "destructiveForeground": "background",
    "muted": "cardRaised",
    "mutedForeground": "foregroundMuted",
    "secondary": "cardRaised",
    "secondaryForeground": "foreground",
    "accent": "cardRaised",
    "accentForeground": "foreground",
    "popover": "card",
    "popoverForeground": "foreground"
  },

  "fonts": {
    "display": "'Space Grotesk', sans-serif",
    "body": "'Inter', sans-serif",
    "mono": "'JetBrains Mono', monospace"
  },

  "radius": {
    "card": "0.875rem",
    "btn": "0.625rem",
    "icon": "0.75rem",
    "chip": "0.375rem",
    "pill": "9999px"
  },

  "shadows": {
    "cyan": "0 4px 14px rgba(34, 211, 238, 0.22)",
    "cyanHover": "0 8px 24px rgba(34, 211, 238, 0.32)"
  },

  "spacing": {
    "$description": "Documentation only — must stay on Tailwind's default 4px step (sp4 = p-4), so no --spacing-* utilities are emitted.",
    "sp1": 4,
    "sp2": 8,
    "sp3": 12,
    "sp4": 16,
    "sp5": 24,
    "sp6": 32,
    "sp7": 48,
    "sp8": 64
  },

  "typeScale": {
    "displayXl": { "size": "44px", "weight": 600, "lh": "1.05", "ls": "-0.02em", "font": "display" },
    "displayLg": { "size": "30px", "weight": 600, "lh": "1.1", "ls": "-0.02em", "font": "display" },
    "heading": { "size": "20px", "weight": 600, "lh": "1.2", "ls": "-0.01em", "font": "display" },
    "body": { "size": "15px", "weight": 400, "lh": "1.5", "ls": "0", "font": "body" },
    "bodySm": { "size": "13px", "weight": 400, "lh": "1.45", "ls": "0", "font": "body" },
    "label": { "size": "11px", "weight": 500, "lh": "1.3", "ls": "0.06em", "font": "mono" },
    "numeral": { "size": "15px", "weight": 500, "lh": "1.3", "ls": "0", "font": "mono" }
  },

  "motion": {
    "easeOutExpo": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durFast": "150ms",
    "durBase": "260ms",
    "durSlow": "480ms",
    "durStagger": "60ms"
  }
}
