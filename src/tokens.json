{
  "$description": "Single source of truth for Atlas design tokens. Edit this file, then run `npm run tokens` to regenerate src/tokens.css and src/tokens.ts. Rationale for each value lives in design.md.",

  "colors": {
    "dark": {
      "background": "#0a0e14",
      "foreground": "#eef4f9",
      "foregroundStrong": "#f8fbfd",
      "foregroundBody": "#b8c4cf",
      "foregroundMuted": { "value": "#828e9a", "note": "clears WCAG AA (4.5:1) on card AND card-raised" },
      "card": "#12181f",
      "cardRaised": "#1a2129",
      "border": "#263140",
      "input": "#263140",
      "primary": "#22d3ee",
      "primaryForeground": "#0a0e14",
      "primaryTint": "rgba(34, 211, 238, 0.1)",
      "amber": "#fbbf24",
      "amberTint": "rgba(251, 191, 36, 0.1)",
      "violet": "#a78bfa",
      "violetTint": "rgba(167, 139, 250, 0.1)",
      "destructive": "#f87171",
      "ring": "#67e8f9"
    },
    "light": {
      "background": "#f4f7fa",
      "foreground": "#0d1420",
      "foregroundStrong": "#060a10",
      "foregroundBody": "#414c59",
      "foregroundMuted": "#5f6a78",
      "card": "#ffffff",
      "cardRaised": "#eef2f6",
      "border": "#d7dee6",
      "input": "#d7dee6",
      "primary": "#0e7490",
      "primaryForeground": "#ffffff",
      "primaryTint": "rgba(14, 116, 144, 0.08)",
      "amber": { "value": "#a94d08", "note": "darkened: clears WCAG AA (4.5:1) as badge text on amber-tint" },
      "amberTint": "rgba(180, 83, 9, 0.08)",
      "violet": "#7c3aed",
      "violetTint": "rgba(124, 58, 237, 0.08)",
      "destructive": "#dc2626",
      "ring": "#0891b2"
    }
  },

  "colorAliases": {
    "$description": "Extra Tailwind color utilities mapped onto existing semantic colors (shadcn expects these names) — not a second palette.",
    "cardForeground": "foreground",
    "destructiveForeground": "background",
    "muted": "cardRaised",
    "mutedForeground": "foregroundMuted",
    "secondary": "cardRaised",
    "secondaryForeground": "foreground",
    "accent": "cardRaised",
    "accentForeground": "foreground",
    "popover": "card",
    "popoverForeground": "foreground"
  },

  "fonts": {
    "display": "'Space Grotesk', sans-serif",
    "body": "'Inter', sans-serif",
    "mono": "'JetBrains Mono', monospace"
  },

  "radius": {
    "card": "0.875rem",
    "btn": "0.625rem",
    "icon": "0.75rem",
    "chip": "0.375rem",
    "pill": "9999px"
  },

  "shadows": {
    "cyan": "0 4px 14px rgba(34, 211, 238, 0.22)",
    "cyanHover": "0 8px 24px rgba(34, 211, 238, 0.32)"
  },

  "spacing": {
    "$description": "Documentation only — must stay on Tailwind's default 4px step (sp4 = p-4), so no --spacing-* utilities are emitted.",
    "sp1": 4,
    "sp2": 8,
    "sp3": 12,
    "sp4": 16,
    "sp5": 24,
    "sp6": 32,
    "sp7": 48,
    "sp8": 64
  },

  "typeScale": {
    "displayXl": { "size": "44px", "weight": 600, "lh": "1.05", "ls": "-0.02em", "font": "display" },
    "displayLg": { "size": "30px", "weight": 600, "lh": "1.1", "ls": "-0.02em", "font": "display" },
    "heading": { "size": "20px", "weight": 600, "lh": "1.2", "ls": "-0.01em", "font": "display" },
    "body": { "size": "15px", "weight": 400, "lh": "1.5", "ls": "0", "font": "body" },
    "bodySm": { "size": "13px", "weight": 400, "lh": "1.45", "ls": "0", "font": "body" },
    "label": { "size": "11px", "weight": 500, "lh": "1.3", "ls": "0.06em", "font": "mono" },
    "numeral": { "size": "15px", "weight": 500, "lh": "1.3", "ls": "0", "font": "mono" }
  },

  "motion": {
    "easeOutExpo": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durFast": "150ms",
    "durBase": "260ms",
    "durSlow": "480ms",
    "durStagger": "60ms"
  }
}
